<!-- ==========================================
           SIDEBAR (30%)
           ========================================== -->
      <aside class='sidebar' id='sidebar' aria-label='Cột bên'>
        <b:section id='sidebar-section' name='Cột Bên (Sidebar)' showaddelement='yes'>

          <!-- Widget: About Me -->
          <b:widget id='HTML2' type='HTML' version='2' title='👤 Về Tác Giả | About Author'>
            <b:includable id='main'>
              <div class='sidebar-widget'>
                <h3 class='sidebar-widget-title' data-bilingual='true'><b:eval expr='data:title ? data:title : &quot;👤 Về Tác Giả | About Author&quot;'/></h3>
                <b:if cond='data:content'>
                  <div class='sidebar-about-custom-content' data-bilingual='true'><data:content/></div>
                <b:else/>
                  <img class='sidebar-about-avatar' alt='Avatar tác giả' width='64' height='64' src=''/>
                  <script>
                    (function(){
                      var u = window.__PROFILE_AVATAR || (function(){ try { return localStorage.getItem('cached_author_avatar'); }catch(e){ return null; } })();
                      if (u) {
                        var el = document.currentScript ? document.currentScript.previousElementSibling : null;
                        if (el) el.src = u;
                      }
                    })();
                  </script>
                  
                  <div class='sidebar-about-text lang-vi'>
                    Chào bạn, đây là một góc nhỏ bình dị để tôi bày tỏ quan điểm, chia sẻ kiến thức và những trải nghiệm sống chân thực. Một điểm dừng chân để chúng ta cùng nhìn cuộc sống dưới những lăng kính thú vị hơn.
                  </div>
                  <div class='sidebar-about-text lang-en'>
                    Welcome to my blog — a humble little corner where I express my perspectives, share knowledge, and document authentic life experiences. A pit stop for us to look at life through more interesting lenses.
                  </div>

                  <div class='sidebar-socials'>
                    <a class='social-icon-link' href='#' target='_blank' rel='noopener' aria-label='Facebook'>f</a>
                    <a class='social-icon-link' href='#' target='_blank' rel='noopener' aria-label='X'>𝕏</a>
                    <a class='social-icon-link' href='#' target='_blank' rel='noopener' aria-label='LinkedIn'>in</a>
                  </div>

                  </b:if>
              </div>
            </b:includable>
          </b:widget>

          <!-- Widget: Popular Posts (Bài Viết Nổi Bật - Tự động theo lượt xem) -->
          <b:widget id='PopularPosts1' type='PopularPosts' version='2' title='🔥 Bài Viết Nổi Bật | 🔥 Popular Posts'>
            <b:includable id='main'>
              <div class='sidebar-widget'>
                <h3 class='sidebar-widget-title' data-bilingual='true'><b:eval expr='data:title == &quot;🔥 Bài Viết Nổi Bật&quot; ? &quot;🔥 Bài Viết Nổi Bật | 🔥 Popular Posts&quot; : (data:title ? data:title : &quot;🔥 Bài Viết Nổi Bật | 🔥 Popular Posts&quot;)'/></h3>
                <b:if cond='data:posts and not data:posts.empty'>
                  <ul class='popular-posts-list'>
                    <b:loop values='data:posts' var='ppPost' index='ppIdx'>
                      <li>
                        <a class='popular-post-item' expr:href='data:ppPost.url'>
                          <span class='popular-post-num'><b:if cond='data:ppIdx &lt; 9'>0</b:if><b:eval expr='data:ppIdx + 1'/></span>
                          <b:if cond='data:ppPost.featuredImage'>
                            <img class='popular-post-thumb' expr:src='data:ppPost.featuredImage'
                                 expr:alt='data:ppPost.title' loading='lazy' width='60' height='60'/>
                          </b:if>
                          <div class='popular-post-info'>
                            <div class='popular-post-title' data-bilingual='true' expr:data-raw-label='data:ppPost.title'><data:ppPost.title/></div>
                            <div class='popular-post-date'>📅 <data:ppPost.date/></div>
                          </div>
                        </a>
                      </li>
                    </b:loop>
                  </ul>
                <b:else/>
                  <p class='popular-posts-empty'>✨ Các bài viết được quan tâm nhất sẽ hiển thị tại đây.</p>
                </b:if>
              </div>
            </b:includable>
          </b:widget>

          <!-- Widget: Standalone Series Showcase (📚 Chuyên Đề | 📚 Series Topic) -->
          <b:widget id='HTML18' type='HTML' version='2' title='📚 Chuyên Đề | 📚 Series Topic'>
            <b:includable id='main'>
              <div class='sidebar-widget special-posts-widget'
                   id='widget-series-showcase'
                   data-pattern='series'
                   data-limit='3'
                   data-sort='random'>
                <b:if cond='data:title'>
                  <b:attr name='data-title' expr:value='data:title'/>
                <b:else/>
                  <b:attr name='data-title' value='📚 Chuyên Đề | 📚 Series Topic'/>
                </b:if>
                <b:if cond='data:content'>
                  <div class='sp-raw-user-content' style='display:none;'><data:content/></div>
                </b:if>
              </div>
            </b:includable>
          </b:widget>

          <!-- Widget: Video & Reels Sidebar (Vị trí 3: Cột bên - Edge to Edge, Auto-slide) -->
          <b:widget id='HTML23' type='HTML' version='2' title='🎬 Video &amp; Reels (Sidebar)' visible='true'>
            <b:includable id='main'>
              <div class='sidebar-widget special-posts-widget'
                   id='widget-sidebar-reels'
                   data-pattern='reels'
                   data-limit='5'
                   data-mode='single'
                   data-sort='random'
                   data-play-mode='modal'>
                <b:if cond='data:title'>
                  <b:attr name='data-title' expr:value='data:title'/>
                <b:else/>
                  <b:attr name='data-title' value='🎬 Video &amp; Reels'/>
                </b:if>
                <b:if cond='data:content'>
                  <div class='sp-raw-user-content' style='display:none;'><data:content/></div>
                </b:if>
              </div>
            </b:includable>
          </b:widget>

          <!-- Widget: Newsletter -->
          <b:widget id='HTML4' type='HTML' version='2' title='📨 Nhận Bản Tin | 📨 Newsletter'>
            <b:includable id='main'>
              <div class='sidebar-widget'>
                <h3 class='sidebar-widget-title' data-bilingual='true'><b:eval expr='data:title == &quot;📨 Nhận Bản Tin&quot; ? &quot;📨 Nhận Bản Tin | 📨 Newsletter&quot; : (data:title ? data:title : &quot;📨 Nhận Bản Tin | 📨 Newsletter&quot;)'/></h3>
                <b:if cond='data:content'>
                  <div class='sidebar-newsletter-custom' data-bilingual='true'><data:content/></div>
                <b:else/>
                  <p class='sidebar-newsletter-text' data-bilingual='true'>Đăng ký để nhận thông báo khi có bài viết mới. Không spam, chỉ nội dung chất lượng. | Subscribe to get notified of new articles. No spam, only quality content.</p>
                  <div class='sidebar-newsletter-form'>
                    <input class='sidebar-email-input' type='email' data-bilingual-placeholder='Email của bạn... | Your email...' placeholder='Email của bạn...' aria-label='Địa chỉ email'/>
                    <button class='sidebar-submit-btn' type='button'><span data-bilingual='true'>💌 Đăng Ký | 💌 Subscribe</span></button>
                  </div>
                </b:if>
              </div>
            </b:includable>
          </b:widget>

          <!-- Widget: AdSense Sidebar (Sticky ở cuối cùng - Mặc định ẩn, bật trong Bố cục khi cần) -->
          <b:widget id='HTML3' type='HTML' version='2' title='Quảng Cáo Sidebar | Sidebar Ads (Sticky)' visible='false'>
            <b:includable id='main'>
              <b:if cond='data:content and data:content != &quot;&quot;'>
                <div class='adsense-slot adsense-sidebar' aria-label='Quảng cáo'>
                  <data:content/>
                </div>
              </b:if>
            </b:includable>
          </b:widget>

        </b:section>
      </aside>
